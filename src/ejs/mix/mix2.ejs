<!DOCTYPE html>
<html lang="ko">
	<head>
		<%-include('../_templates/_guide.head.ejs', {
			pageJavascript: ''
		}) %>
		<!-- Swiper JS -->
		<script src="../../assets/js/lenis.min.js"></script>
		<script src="../../assets/js/common-ui.js"></script>
		<style>
			* {margin:0; padding:0;}

			.section-wrap {position: relative;}
			.section {font-size: 60px;}
			.section-01{width:100%; height: 100vh; position: sticky; top: 0;}
			.section-02 {width:100%; height: 200vh; position: sticky; top: 0;}
			.section-02 p {
				font-size: 60px;
				position: sticky;
				top:0;
				text-align: center;
				width: 100%;
				height: 100vh;
				background-color: rgb(26, 187, 236);
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.section-03 {width:100%; height: 300vh; position: sticky; top: 0; padding:0 20px; box-sizing: border-box;}
			.section-03 p {
					font-size: 60px;
					position: sticky;
					top:0;
					text-align: center;
					width: 100%;
					height: 100vh;
					background-color: rgb(172, 36, 149);
					display: flex;
					align-items: center;
					justify-content: center;
			}

			.section-01 {background-color: red;}
			.section-02 {background-color: orange;}
			.section-03 {background-color: yellow;}
			.section-04 {background-color: orange; height: auto;}
	</style>

	</head>
	<body class="gcar">
		<div id="wrap">
			<!-- page-body -->
			<div class="page-body">
        		<main id="main" class="page main">
					<div class="section-wrap">
						<div class="section section-01">section-01</div>
						<div class="section section-02">
							<p>section-02<br>hahaha1</p>
						</div>
						<div class="section section-03">
							<p>section-03<br>hahaha2</p>
						</div>
					</div>
					<div class="section section-04 auto-scroll">
							section-04<br>
							뽠온갸가 보록데잴미에게 잴가베의 입죠머박는다 즛퍄두뒤글이고 솨뎀도헤덩는데, 반렿 오탄까 낙종간이.
							뜨드힌이를 져업말린 으죰을 쳠강엄긴다 요니입깈이던 돡니하는 절인은 룬휴타운아 러럼습니다.
							으깅 녀리에서 으넌 버나가, 판바으 미릭쳰는 벼오온. 아햐안윔을 옥얻옷이 밍자에 아안사혐은 뎡르후톤반을 노머핳쇼에 손샌묜뺜은 운대깅재주으에.
							보허누가 엥저는 알비고애룀 칠측도래눈이 뇨위골밍래겊다 나안옹다 아찬눌올 디으고며에 소수넌입다웅으뿐 변익미곤이 엡란에요.
							보가슴으며 스로뭐다 거덩고 익므세면 줘와 디은로에서.
					</div>
				</main>
			</div>
			<!--// page-body -->
		</div>
		<script>
			window.addEventListener('load', () => {
				mainAnimation();

				function mainAnimation() {
						const CONFIG = {
								SECTION_02_EXIT_THRESHOLD: 0.2, // Section-02 상단 20%에서 Section-01로 스냅
								SECTION_03_EXIT_THRESHOLD: 0.2,
								DEBUG: true,
						};

						const log = (...args) => CONFIG.DEBUG && console.log(...args);
						const snapSections = document.querySelectorAll('.section-01, .section-02, .section-03');
						const section02 = snapSections[1];
						const section03 = snapSections[2];

						// 섹션 위치 계산
						const getSectionPositions = () => {
								let cumulativeHeight = 0;
								const positions = [];

								snapSections.forEach((section, i) => {
										positions.push(cumulativeHeight);
										cumulativeHeight += section.offsetHeight;
										log(`📏 Section-${i + 1} position: ${positions[i]}px, height: ${section.offsetHeight}px`);
								});

								return positions;
						};

						let sectionPositions = getSectionPositions();

						let isSnapping = false;
						let currentSectionIndex = 0;
						let wheelCooldown = false;

						// 현재 섹션 인덱스 계산
						const getCurrentSectionIndex = () => {
								const scrollY = lenis.scroll;
								for (let i = sectionPositions.length - 1; i >= 0; i--) {
										if (scrollY >= sectionPositions[i] - 10) {
												return i;
										}
								}
								return 0;
						};

						// 스냅 실행
						const snapTo = (targetIndex, toBottom = false) => {
								if (isSnapping) return;

								isSnapping = true;
								wheelCooldown = true;

								let targetTop = sectionPositions[targetIndex];
								
								// Section-02로 스냅할 때 하단으로 이동 옵션
								if (toBottom && targetIndex === 1) {
										targetTop = sectionPositions[1] + section02.offsetHeight - window.innerHeight;
										log(`🎯 Snapping to Section-02 BOTTOM (${targetTop}px)`);
								} else {
										log(`🎯 Snapping to Section-${String(targetIndex + 1).padStart(2, '0')} (${targetTop}px)`);
								}

								lenis.stop();

								lenis.scrollTo(targetTop, {
										duration: 1.2,
										easing: (t) => 1 - Math.pow(1 - t, 3),
										force: true,
										lock: true,
										onComplete: () => {
												isSnapping = false;
												currentSectionIndex = targetIndex;
												lenis.start();
												log(`✅ Snap complete - now at Section-${String(targetIndex + 1).padStart(2, '0')} (${targetTop}px)`);

												setTimeout(() => {
														wheelCooldown = false;
														log('🔓 Wheel unlocked');
												}, 600);
										}
								});
						};

						// 스냅 처리 로직
						const handleSnap = (currentIndex, direction) => {
								const scrollY = lenis.scroll;
								log(`📍 Current: Section-${currentIndex + 1}, Direction: ${direction > 0 ? 'DOWN ⬇' : 'UP ⬆'}, ScrollY: ${Math.round(scrollY)}`);

								if (direction > 0) {
										// 아래로 스크롤 ⬇
										if (currentIndex === 0) {
												snapTo(1);
										} else if (currentIndex === 1) {
												// Section-02 내부는 자유 스크롤
												const section02Bottom = sectionPositions[1] + section02.offsetHeight;

												if (scrollY >= section02Bottom - window.innerHeight) {
														snapTo(2); // Section-03으로 스냅
												}
										} else if (currentIndex === 2) {
												// Section-03 내부는 자유 스크롤
												const section03Bottom = sectionPositions[2] + section03.offsetHeight;

												if (scrollY >= section03Bottom - window.innerHeight) {
														log('🔓 Entering Section-04 - Free scroll enabled');
												}
										}
								} else {
										// 위로 스크롤 ⬆
										const section02Top = sectionPositions[1];
										const section02Bottom = section02Top + section02.offsetHeight;
										const section03Top = sectionPositions[2];
										const section03Bottom = section03Top + section03.offsetHeight;

										// Section-04에서 Section-03으로 자유 스크롤
										if (scrollY > section03Bottom) {
												log('📍 In Section-04, scrolling up - Free scroll');
												return;
										}

										if (currentIndex === 0) {
												// Section-01에서는 위로 갈 곳이 없음
												return;
										} else if (currentIndex === 1) {
												// Section-02에서 위로 스크롤 시 상단 20%에서만 Section-01로 스냅
												const sectionTop = sectionPositions[1];
												const sectionHeight = section02.offsetHeight;
												const progress = scrollY - sectionTop;
												const threshold = sectionHeight * CONFIG.SECTION_02_EXIT_THRESHOLD;

												if (progress < threshold) {
														log('🎯 Section-02 top 20% → Snap to Section-01');
														snapTo(0);
												} else {
														log('📍 Section-02 middle/bottom - Free scroll');
												}
										} else if (currentIndex === 2) {
												const sectionTop = sectionPositions[2];
												const sectionHeight = section03.offsetHeight;
												const progress = scrollY - sectionTop;
												const threshold = sectionHeight * CONFIG.SECTION_03_EXIT_THRESHOLD;

												if (progress < threshold) {
														log('🎯 Section-03 top 20% → Snap to Section-02 BOTTOM');
														snapTo(1, true); // toBottom = true로 Section-02 하단으로 이동
												} else {
														log('📍 Section-03 middle/bottom - Free scroll');
												}
										}
								}
						};

						// 휠 이벤트 직접 감지
						window.addEventListener('wheel', (e) => {
								// 스냅 중이거나 쿨다운 중이면 완전히 무시
								if (isSnapping || wheelCooldown) {
										e.preventDefault();
										e.stopPropagation();
										e.stopImmediatePropagation();
										log('🚫 Wheel blocked - snap in progress');
										return false;
								}

								const scrollY = lenis.scroll;
								const sectionIndex = getCurrentSectionIndex();
								const direction = e.deltaY > 0 ? 1 : -1;

								log(`🖱 Wheel: deltaY=${e.deltaY.toFixed(1)}, direction=${direction > 0 ? 'DOWN' : 'UP'}, section=${sectionIndex + 1}`);

								// Section-04 영역에서는 자유 스크롤
								const section03Bottom = sectionPositions[2] + snapSections[2].offsetHeight;
								if (scrollY > section03Bottom && direction > 0) {
										return;
								}

								if (Math.abs(e.deltaY) > 1) {
										e.preventDefault();
										handleSnap(sectionIndex, direction);
								}
						}, { passive: false, capture: true });

						// 초기 섹션 설정
						currentSectionIndex = getCurrentSectionIndex();
						log(`🚀 Initial Section: ${currentSectionIndex + 1}`);

						// 리사이즈 대응
						let resizeTimer;
						window.addEventListener('resize', () => {
								clearTimeout(resizeTimer);
								resizeTimer = setTimeout(() => {
										sectionPositions = getSectionPositions();
										const index = getCurrentSectionIndex();
										if (index >= 0) {
												lenis.scrollTo(sectionPositions[index], { immediate: true });
												currentSectionIndex = index;
										}
								}, 150);
						});

						log('✅ Lenis Sticky Snap Scroll Activated');
					}
			});
