	<script>
		const swiperModuleA = new Swiper('.swiper-list.module-a', {
			slidesPerView: 4,
			spaceBetween: 24,
			breakpoints: {
				0: {
					slidesPerView: 1.1,
					spaceBetween: 16
				},
				1024: {
					slidesPerView: 3.9,
					spaceBetween: 24
				}
			}
		});

		// 가상 스크롤
		(function () {
			const wrap = document.getElementById('fakeScroll');
			const content = wrap.querySelector('.fake-scroll__content');
			const track = wrap.querySelector('.fake-scroll__track');
			const thumb = wrap.querySelector('.fake-scroll__thumb');

			let isDragging = false;
			let dragStartX = 0;
			let contentStartScrollLeft = 0;

			function updateThumb() {
				const visibleRatio = content.clientWidth / content.scrollWidth;

				if (visibleRatio >= 1) {
					thumb.style.display = 'none';
					return;
				}

				thumb.style.display = 'block';

				const trackWidth = track.clientWidth;
				const thumbWidth = Math.max(trackWidth * visibleRatio, 24);
				const maxThumbLeft = trackWidth - thumbWidth;
				const maxScrollLeft = content.scrollWidth - content.clientWidth;

				const scrollRatio = content.scrollLeft / maxScrollLeft;

				thumb.style.width = thumbWidth + 'px';
				thumb.style.transform = 'translateX(' + (scrollRatio * maxThumbLeft) + 'px)';
			}

			function onContentScroll() {
				updateThumb();
			}

			function onThumbDown(e) {
				e.preventDefault();
				isDragging = true;
				dragStartX = e.clientX;
				contentStartScrollLeft = content.scrollLeft;

				document.addEventListener('mousemove', onDocumentMove);
				document.addEventListener('mouseup', onDocumentUp);
			}

			function onDocumentMove(e) {
				if (!isDragging) return;

				const deltaX = e.clientX - dragStartX;
				const trackWidth = track.clientWidth;
				const thumbWidth = thumb.offsetWidth;
				const maxThumbLeft = trackWidth - thumbWidth;
				const maxScrollLeft = content.scrollWidth - content.clientWidth;

				const scrollDelta = (deltaX / maxThumbLeft) * maxScrollLeft;

				content.scrollLeft = Math.min(
					Math.max(contentStartScrollLeft + scrollDelta, 0),
					maxScrollLeft
				);
			}

			function onDocumentUp() {
				isDragging = false;
				document.removeEventListener('mousemove', onDocumentMove);
				document.removeEventListener('mouseup', onDocumentUp);
			}

			function onTrackClick(e) {
				if (e.target === thumb) return;

				const rect = track.getBoundingClientRect();
				const clickX = e.clientX - rect.left;

				const thumbWidth = thumb.offsetWidth;
				const trackWidth = track.clientWidth;
				const maxThumbLeft = trackWidth - thumbWidth;
				const maxScrollLeft = content.scrollWidth - content.clientWidth;

				const thumbPos = Math.min(
					Math.max(clickX - thumbWidth / 2, 0),
					maxThumbLeft
				);

				const scrollLeft = (thumbPos / maxThumbLeft) * maxScrollLeft;

				content.scrollLeft = scrollLeft;
			}

			content.addEventListener('scroll', onContentScroll);
			thumb.addEventListener('mousedown', onThumbDown);
			track.addEventListener('click', onTrackClick);
			window.addEventListener('resize', updateThumb);

			updateThumb();
		})();

	</script>
